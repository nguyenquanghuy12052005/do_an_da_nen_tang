default_platform(:android)

platform :android do
  desc 'Build signed Android APK and AAB; upload is handled by CI.'
  lane :build_signed do
    required = %w[
      ANDROID_KEYSTORE_FILE
      ANDROID_KEYSTORE_PASSWORD
      ANDROID_KEY_ALIAS
      ANDROID_KEY_PASSWORD
    ]
    missing = required.select { |name| ENV[name].to_s.empty? }
    UI.user_error!("Missing Android signing configuration: #{missing.join(', ')}") unless missing.empty?
    UI.user_error!('Upload keystore file is missing') unless File.file?(ENV.fetch('ANDROID_KEYSTORE_FILE'))

    Dir.chdir('..') do
      pubspec = File.read('pubspec.yaml')
      version = pubspec.match(/^version:\s*(\d+\.\d+\.\d+\+\d+)\s*$/)&.captures&.first
      UI.user_error!('pubspec.yaml needs version x.y.z+N') if version.nil?
      symbols = "build/symbols/#{version}"

      sh('flutter', 'build', 'apk', '--release', '--obfuscate', "--split-debug-info=#{symbols}")
      # On Flutter 3.47.5 the obfuscated AAB omits libapp.so.sym, so Flutter's
      # release verification rejects it. The non-obfuscated AAB retains native
      # symbols and passes that check; the APK still has Dart symbol files.
      sh('flutter', 'build', 'appbundle', '--release')

      UI.user_error!('Signed APK was not produced') unless File.file?('build/app/outputs/flutter-apk/app-release.apk')
      UI.user_error!('Signed AAB was not produced') unless File.file?('build/app/outputs/bundle/release/app-release.aab')
    end
  end
end
