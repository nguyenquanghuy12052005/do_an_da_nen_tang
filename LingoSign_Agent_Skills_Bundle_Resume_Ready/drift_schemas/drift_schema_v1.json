  "fixed_sql": [
    {
      "name": "sign_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sign_entries\" (\"code\" TEXT NOT NULL, \"label_vi\" TEXT NOT NULL, \"description\" TEXT NULL, \"media_local_path\" TEXT NULL, \"catalog_version\" TEXT NOT NULL, \"source_url\" TEXT NOT NULL, \"license_name\" TEXT NOT NULL, \"updated_at_utc_ms\" INTEGER NOT NULL, PRIMARY KEY (\"code\")) STRICT;"
        }
      ]
    },
    {
      "name": "recognition_history_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recognition_history_rows\" (\"id\" TEXT NOT NULL, \"sign_code\" TEXT NOT NULL REFERENCES sign_entries (code) ON DELETE RESTRICT, \"label_snapshot\" TEXT NOT NULL, \"confirmed_at_utc_ms\" INTEGER NOT NULL, \"deleted_at_utc_ms\" INTEGER NULL, PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "pending_sync_ops",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_sync_ops\" (\"op_id\" TEXT NOT NULL, \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"operation\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL, \"created_at_utc_ms\" INTEGER NOT NULL, \"retry_count\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, PRIMARY KEY (\"op_id\")) STRICT;"
        }
      ]
    },
    {
      "name": "sync_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_states\" (\"collection\" TEXT NOT NULL, \"last_cursor\" TEXT NULL, \"last_success_at_utc_ms\" INTEGER NULL, PRIMARY KEY (\"collection\")) STRICT;"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value_json\" TEXT NOT NULL, \"updated_at_utc_ms\" INTEGER NOT NULL, PRIMARY KEY (\"key\")) STRICT;"
        }
      ]
    }
